# mock | live
VITE_API_MODE=mock

# Backend API (déploiement same-origin recommandé)
VITE_API_SERVER_URL=/api
VITE_DEV_API_TARGET=

# Amadeus API (vols)
VITE_AMADEUS_CLIENT_ID=
VITE_AMADEUS_CLIENT_SECRET=

# Hotels API (hôtels)
VITE_HOTELS_API_KEY=your_hotels_api_key

# Serveur Auth (optionnel si VITE_API_SERVER_URL est défini)
VITE_AUTH_SERVER_URL=/api/auth

# Serveur Paiement (optionnel si VITE_API_SERVER_URL est défini)
VITE_PAYMENT_SERVER_URL=/api/payments
VITE_STRIPE_PUBLIC_KEY=
